rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidStoryProject(data, userId) {
      return data.userId == userId
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && (!('prompt' in data) || data.prompt is string)
        && (!('youtubeUrl' in data) || data.youtubeUrl is string)
        && (!('aspectRatio' in data) || data.aspectRatio is string)
        && (!('style' in data) || data.style is string)
        && (!('status' in data) || data.status is string)
        && (!('bgmTrackName' in data) || data.bgmTrackName is string)
        && (!('voiceName' in data) || data.voiceName is string)
        && (!('scenes' in data) || data.scenes is list)
        && (!('fullScript' in data) || data.fullScript is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId
        && data.email is string && data.email.size() <= 254
        && (!('displayName' in data) || data.displayName is string)
        && (!('preferredVoice' in data) || data.preferredVoice is string)
        && (!('preferredRatio' in data) || data.preferredRatio is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      match /stories/{storyId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidStoryProject(request.resource.data, userId)
          && request.resource.data.createdAt <= request.time;
        allow update: if isOwner(userId)
          && isValidStoryProject(request.resource.data, userId)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt <= request.time;
        allow delete: if isOwner(userId);
      }

      match /profile/{profileDoc} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidUserProfile(request.resource.data, userId)
          && request.resource.data.createdAt <= request.time;
        allow update: if isOwner(userId)
          && isValidUserProfile(request.resource.data, userId)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt <= request.time;
        allow delete: if isOwner(userId);
      }
    }
  }
}
